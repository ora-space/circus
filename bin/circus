#!/usr/bin/env bash
# circus: GitHub-as-database helper. Status and priority live in issue labels;
# the circus GitHub Action mirrors them onto the Project board.
set -euo pipefail

ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# shellcheck source=../circus.env
source "$ROOT/circus.env"

# Parallel arrays: label slug ↔ Project Status name. Done is not a label: it is a closed issue.
STATUS_SLUGS=(inbox ready running needs-owner in-review)
STATUS_NAMES=("Inbox" "Ready" "Running" "Needs Owner" "In Review")
STATUS_COLORS=(GRAY BLUE YELLOW RED PURPLE)
STATUS_DESCRIPTIONS=("未分诊" "可以开工" "有运行 issue 在做" "等 owner 回复、决策或授权" "PR 待 owner 审")
PRIORITIES=(p0 p1 p2 p3)
TYPES=(task bug decision question idea)
REPOS=(desktop specs cluster cloud sandbox marketplace)

die() { echo "circus: $*" >&2; exit 1; }

# Windows builds of jq may emit CRLF; values with a trailing \r break later calls.
jq() { command jq "$@" | tr -d '\r'; }

usage() {
  cat <<'EOF'
usage: bin/circus <command>

  brief [STATUS]           按 Status 列出未关闭的事项，附带进行中的运行 issue
  new --title T --type TYPE [--repo R]... [--priority P] [--status S] [--body-file F]
                           新建事项 issue，输出链接；--body-file - 读 stdin
  run N [--body-file F]    为事项 #N 开一个运行 issue（worker 每次工作开一个），输出链接
  set N VALUE...           设置事项的 Status（Ready、"Needs Owner"、Done 等）或 Priority（P0–P3）；需要写权限
  memory                   从 memory/ 各文件的 frontmatter 生成记忆索引
  setup                    owner 用：创建/校正 labels 和 Project 字段（幂等，需要 project scope）

STATUS 取值：Inbox、Ready、Running、"Needs Owner"、"In Review"、Done。
EOF
}

contains() {
  local needle=$1; shift
  local x
  for x in "$@"; do [[ $x == "$needle" ]] && return 0; done
  return 1
}

# Accept "Needs Owner", needs-owner, needs_owner, ... and print the label slug.
status_slug() {
  local s i
  s=$(tr 'A-Z' 'a-z' <<<"$1" | tr ' _' '-')
  [[ $s == done ]] && { echo done; return; }
  for i in "${!STATUS_SLUGS[@]}"; do
    [[ $s == "${STATUS_SLUGS[$i]}" ]] && { echo "$s"; return; }
  done
  return 1
}

cmd_brief() {
  local filter='' issues order labels i
  if [[ -n ${1:-} ]]; then filter=$(status_slug "$1") || die "未知 Status：$1"; fi
  issues=$(gh issue list -R "$CIRCUS_REPO" --state open --limit 1000 --json number,title,labels,body)
  order=$(printf '%s\n' "${STATUS_SLUGS[@]}" | jq -R . | jq -sc .)
  labels='{}'
  for i in "${!STATUS_SLUGS[@]}"; do
    labels=$(jq -c --arg k "${STATUS_SLUGS[$i]}" --arg v "${STATUS_NAMES[$i]}" '. + {($k): $v}' <<<"$labels")
  done
  jq -r --arg filter "$filter" --argjson order "$order" --argjson label "$labels" '
    def names: [.labels[].name];
    def parent: [.body | split("\n")[] | capture("^Parent:\\s*#(?<n>[0-9]+)")?.n] | first;
    (map(select(names | index("run"))) | map({key: (parent // ""), value: "#\(.number)"})
      | group_by(.key) | map({key: .[0].key, value: (map(.value) | join(" "))}) | from_entries) as $runs
    | [.[] | select(names | index("run") | not)
        | {n: .number, title,
           status: ((names | map(select(startswith("status:")) | ltrimstr("status:")) | first) // "(无)"),
           priority: ((names | map(select(startswith("priority:")) | ltrimstr("priority:") | ascii_upcase) | first) // "-")}
        | select($filter == "" or .status == $filter)]
    | group_by(.status)
    | sort_by(.[0].status as $s | $order | index($s) // 99)
    | .[]
    | "## \($label[.[0].status] // .[0].status) (\(length))",
      (sort_by(.priority)[] | "- [\(.priority)] #\(.n) \(.title)\(if $runs["\(.n)"] then "（运行：\($runs["\(.n)"])）" else "" end)"),
      ""
  ' <<<"$issues"
}

cmd_new() {
  local title='' type='' priority=p2 status=inbox body_file='' repos=()
  while [[ $# -gt 0 ]]; do
    case $1 in
      --title) title=$2; shift 2 ;;
      --type) type=$2; shift 2 ;;
      --repo) repos+=("$2"); shift 2 ;;
      --priority) priority=$(tr 'A-Z' 'a-z' <<<"$2"); shift 2 ;;
      --status) status=$(status_slug "$2") || die "new: 未知 Status $2"; shift 2 ;;
      --body-file) body_file=$2; shift 2 ;;
      *) die "new: 未知参数 $1" ;;
    esac
  done
  [[ -n $title ]] || die "new: 缺少 --title"
  contains "$type" "${TYPES[@]}" || die "new: --type 取值为 ${TYPES[*]}"
  contains "$priority" "${PRIORITIES[@]}" || die "new: --priority 取值为 P0–P3"
  [[ $status != done ]] || die "new: 新事项不能是 Done"
  # Labels need write access; for read-only callers GitHub drops them and the Action
  # falls back to status:inbox / priority:p2.
  local args=(-R "$CIRCUS_REPO" --title "$title" --label "type:$type" --label "status:$status" --label "priority:$priority") r
  for r in "${repos[@]}"; do args+=(--label "repo:$r"); done
  if [[ -n $body_file ]]; then args+=(--body-file "$body_file"); else args+=(--body ""); fi
  gh issue create "${args[@]}"
}

cmd_run() {
  [[ ${1:-} =~ ^[0-9]+$ ]] || die "run: 用法 bin/circus run N [--body-file F]"
  local n=$1 body_file='' title extra=''
  shift
  [[ ${1:-} == --body-file ]] && body_file=$2
  title=$(gh issue view "$n" -R "$CIRCUS_REPO" --json title --jq .title)
  [[ -n $body_file ]] && extra=$(cat "$body_file")
  gh issue create -R "$CIRCUS_REPO" --title "运行：$title" --body "$(printf 'Parent: #%s\n\n%s' "$n" "$extra")"
}

cmd_set() {
  [[ ${1:-} =~ ^[0-9]+$ && $# -ge 2 ]] || die "set: 用法 bin/circus set N VALUE..."
  local n=$1 value slug current add=() remove=()
  shift
  current=$(gh issue view "$n" -R "$CIRCUS_REPO" --json labels --jq '.labels[].name')
  for value in "$@"; do
    if [[ $value =~ ^[Pp][0-3]$ ]]; then
      remove+=($(grep '^priority:' <<<"$current" || true))
      add+=("priority:$(tr 'P' 'p' <<<"$value")")
    elif slug=$(status_slug "$value"); then
      remove+=($(grep '^status:' <<<"$current" || true))
      if [[ $slug == done ]]; then
        gh issue close "$n" -R "$CIRCUS_REPO" >/dev/null
      else
        add+=("status:$slug")
        gh issue reopen "$n" -R "$CIRCUS_REPO" >/dev/null 2>&1 || true
      fi
    else
      die "未知取值：$value"
    fi
  done
  local args=() l
  for l in "${remove[@]}"; do contains "$l" "${add[@]}" || args+=(--remove-label "$l"); done
  for l in "${add[@]}"; do args+=(--add-label "$l"); done
  [[ ${#args[@]} -eq 0 ]] || gh issue edit "$n" -R "$CIRCUS_REPO" "${args[@]}" >/dev/null
}

cmd_memory() {
  local dir f summary scope
  for dir in rules methods preferences; do
    echo "## $dir"
    for f in "$ROOT/memory/$dir"/*.md; do
      [[ -e $f ]] || continue
      summary=$(sed -n '2,/^---$/s/^summary: *//p' "$f")
      scope=$(sed -n '2,/^---$/s/^scope: *//p' "$f")
      echo "- memory/$dir/$(basename "$f") [$scope] $summary"
    done
    echo
  done
}

cmd_setup() {
  local t r i
  for t in "${TYPES[@]}"; do gh label create "type:$t" -R "$CIRCUS_REPO" --color 1d76db --force >/dev/null; done
  for r in "${REPOS[@]}"; do gh label create "repo:$r" -R "$CIRCUS_REPO" --color c5def5 --force >/dev/null; done
  for i in "${!STATUS_SLUGS[@]}"; do
    gh label create "status:${STATUS_SLUGS[$i]}" -R "$CIRCUS_REPO" --color fbca04 \
      --description "${STATUS_DESCRIPTIONS[$i]}" --force >/dev/null
  done
  for t in "${PRIORITIES[@]}"; do gh label create "priority:$t" -R "$CIRCUS_REPO" --color d93f0b --force >/dev/null; done
  gh label create run -R "$CIRCUS_REPO" --color 5319e7 --description "worker 的一次工作" --force >/dev/null
  gh label create memory -R "$CIRCUS_REPO" --color 0e8a16 --description "记忆变更 PR" --force >/dev/null
  echo "labels ok"

  if [[ -z "${CIRCUS_PROJECT:-}" ]]; then
    CIRCUS_PROJECT=$(gh project create --owner "$CIRCUS_OWNER" --title circus --format json --jq .number)
    sed -i "s/^CIRCUS_PROJECT=.*/CIRCUS_PROJECT=$CIRCUS_PROJECT/" "$ROOT/circus.env"
    echo "已创建 Project #$CIRCUS_PROJECT，并写入 circus.env（记得提交）"
  fi
  gh project link "$CIRCUS_PROJECT" --owner "$CIRCUS_OWNER" --repo "${CIRCUS_REPO#*/}" >/dev/null 2>&1 || true

  local fields status_id current wanted opts='[]'
  fields=$(gh project field-list "$CIRCUS_PROJECT" --owner "$CIRCUS_OWNER" --format json)
  status_id=$(jq -r '.fields[] | select(.name == "Status") | .id' <<<"$fields")
  [[ -n $status_id ]] || die "Project 没有内置 Status 字段"
  current=$(jq -c '[.fields[] | select(.name == "Status") | .options[].name]' <<<"$fields")
  wanted=$(printf '%s\n' "${STATUS_NAMES[@]}" Done | jq -R . | jq -sc .)
  if [[ $current != "$wanted" ]]; then
    for i in "${!STATUS_NAMES[@]}"; do
      opts=$(jq -c --arg n "${STATUS_NAMES[$i]}" --arg c "${STATUS_COLORS[$i]}" --arg d "${STATUS_DESCRIPTIONS[$i]}" \
        '. + [{name: $n, color: $c, description: $d}]' <<<"$opts")
    done
    opts=$(jq -c '. + [{name: "Done", color: "GREEN", description: "issue 已关闭"}]' <<<"$opts")
    jq -n --arg f "$status_id" --argjson o "$opts" '{
      query: "mutation($f: ID!, $o: [ProjectV2SingleSelectFieldOptionInput!]) { updateProjectV2Field(input: {fieldId: $f, singleSelectOptions: $o}) { projectV2Field { ... on ProjectV2SingleSelectField { id } } } }",
      variables: {f: $f, o: $o}
    }' | gh api graphql --input - >/dev/null
    echo "Status 选项已设为：$(jq -r 'join(", ")' <<<"$wanted")"
  fi
  if ! jq -e '.fields[] | select(.name == "Priority")' <<<"$fields" >/dev/null; then
    gh project field-create "$CIRCUS_PROJECT" --owner "$CIRCUS_OWNER" --name Priority \
      --data-type SINGLE_SELECT --single-select-options P0,P1,P2,P3 >/dev/null
    echo "已创建 Priority 字段"
  fi
  echo "project ok: https://github.com/orgs/$CIRCUS_OWNER/projects/$CIRCUS_PROJECT"
}

case ${1:-} in
  brief) shift; cmd_brief "$@" ;;
  new) shift; cmd_new "$@" ;;
  run) shift; cmd_run "$@" ;;
  set) shift; cmd_set "$@" ;;
  memory) shift; cmd_memory "$@" ;;
  setup) shift; cmd_setup "$@" ;;
  -h | --help | help | '') usage ;;
  *) usage; exit 1 ;;
esac
